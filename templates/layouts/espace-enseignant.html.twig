{#
    Layout intermédiaire pour l'Espace Enseignant.

    Factorise la structure commune à toutes les pages de l'espace enseignant
    (sidebar, header mobile, fil d'Ariane, conteneur principal).

    Variables attendues côté contrôleur :
        • teacher (array) — données de l'enseignant connecté
                            (firstName, lastName, specialite)

    Variables/blocs à définir dans le template enfant :
        • activePage (set)         — clé courante pour la sidebar (ex: 'notes')
        • breadcrumb (set, list)   — items du fil d'Ariane : [{ label, route?, params? }, …]
        • page_content (block)     — contenu principal de la page

    Variables optionnelles :
        • mobileTitle (set)        — titre barre mobile (défaut: 'Espace Enseignant')
        • scrollMode (set, bool)   — true = scrollable / false = hauteur fixe (défaut: true)
#}
{% extends 'layouts/espace.html.twig' %}

{% set scrollMode = scrollMode ?? true %}
{% set mobileTitle = mobileTitle ?? 'Espace Enseignant' %}

{% block content %}
    <div class="d-flex {{ scrollMode ? 'espace-layout-scroll' : 'espace-layout-fixed' }}">
        {{ include('espace/enseignant/_navbar.html.twig') }}

        <main class="flex-grow-1 d-flex flex-column bg-white {{ scrollMode ? 'espace-main-scroll' : 'espace-main-fixed' }}">
            {# Header mobile — masqué sur desktop (d-lg-none) #}
            <header class="d-lg-none bg-dark text-white px-3 py-2 d-flex align-items-center justify-content-between flex-shrink-0">
                <span class="fw-bold">GEII — {{ mobileTitle }}</span>
                <button class="btn btn-sm btn-outline-secondary" type="button"
                        data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar">
                    <i class="bi bi-list"></i>
                </button>
            </header>

            {# Fil d'Ariane — construit dynamiquement depuis la variable `breadcrumb` #}
            {% if breadcrumb is defined and breadcrumb|length > 0 %}
                <div class="px-4 py-2 border-bottom d-flex align-items-center gap-2 flex-shrink-0 bg-white espace-breadcrumb">
                    <i class="bi bi-layout-sidebar text-label" style="font-size:.9rem;"></i>
                    <nav aria-label="fil d'ariane">
                        <ol class="breadcrumb mb-0" style="font-size:.875rem;">
                            {% for item in breadcrumb %}
                                {% if loop.last %}
                                    <li class="breadcrumb-item active fw-medium">{{ item.label }}</li>
                                {% elseif item.route is defined %}
                                    <li class="breadcrumb-item">
                                        <a href="{{ path(item.route, item.params ?? {}) }}"
                                           class="text-label text-decoration-none">{{ item.label }}</a>
                                    </li>
                                {% else %}
                                    <li class="breadcrumb-item text-label">{{ item.label }}</li>
                                {% endif %}
                            {% endfor %}
                        </ol>
                    </nav>
                </div>
            {% endif %}

            <div class="{{ scrollMode ? 'espace-content-scroll' : 'espace-content' }}">
                {# Flash messages #}
                {% for type, messages in app.flashes(['success', 'danger', 'warning', 'info']) %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type == 'danger' ? 'danger' : (type == 'success' ? 'success' : (type == 'warning' ? 'warning' : 'info')) }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                        </div>
                    {% endfor %}
                {% endfor %}

                {% block page_content %}{% endblock %}
            </div>
        </main>
    </div>
{% endblock %}
