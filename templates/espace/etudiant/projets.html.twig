{% extends 'layouts/espace.html.twig' %}

{% block title %}Projets tuteurés — Espace Étudiant — GEII{% endblock %}

{% block content %}
    {% set activePage = 'projets' %}

    <div class="d-flex espace-layout-scroll">
        {{ include('espace/etudiant/_navbar.html.twig') }}

        <main class="flex-grow-1 d-flex flex-column bg-white espace-main-scroll">
            {# Mobile header #}
            <header class="d-lg-none bg-dark text-white px-3 py-2 d-flex align-items-center justify-content-between flex-shrink-0">
                <span class="fw-bold">GEII — Espace Étudiant</span>
                <button class="btn btn-sm btn-outline-secondary" type="button"
                        data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar">
                    <i class="bi bi-list"></i>
                </button>
            </header>

            {# Fil d'Ariane #}
            <div class="px-4 py-2 border-bottom d-flex align-items-center gap-2 flex-shrink-0 bg-white espace-breadcrumb">
                <i class="bi bi-layout-sidebar text-label" style="font-size:.9rem;"></i>
                <nav aria-label="fil d'Ariane">
                    <ol class="breadcrumb mb-0" style="font-size:.875rem;">
                        <li class="breadcrumb-item">
                            <a href="{{ path('app_espace_etudiant_index') }}" class="text-label text-decoration-none">Espace étudiant</a>
                        </li>
                        <li class="breadcrumb-item active fw-medium">Projets tuteurés</li>
                    </ol>
                </nav>
            </div>

            <div class="espace-content-scroll">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="page-icon page-icon--projets rounded-3 d-flex align-items-center justify-content-center">
                        <i class="bi bi-kanban fs-4" style="color:#6d28d9;"></i>
                    </div>
                    <div>
                        <h1 class="h3 mb-0 fw-bold">Projets tuteurés</h1>
                        <p class="mb-0 text-muted-sm">{{ projects|length }} projet(s) en cours</p>
                    </div>
                </div>

                <div class="row g-3">
                    {% for project in projects %}
                    <div class="col-lg-6">
                        <div class="border rounded-3 p-4 h-100 d-flex flex-column">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <span class="project-status-pill rounded-pill px-3 py-1">
                                    <i class="bi bi-circle-fill me-1" style="font-size:.45rem;vertical-align:middle;"></i>
                                    {{ project.status }}
                                </span>
                                <span class="text-meta">
                                    <i class="bi bi-person me-1"></i>{{ project.teacher }}
                                </span>
                            </div>
                            <h2 class="fw-bold mb-2" style="font-size:1.2rem;">{{ project.title }}</h2>
                            <p class="flex-grow-1 mb-4 text-meta" style="font-size:1rem;">{{ project.description }}</p>
                            <div>
                                <div class="d-flex justify-content-between mb-2 text-meta">
                                    <span>Progression</span>
                                    <span class="fw-semibold text-dark">{{ project.progress }}&nbsp;%</span>
                                </div>
                                <div class="progress-track"
                                     role="progressbar"
                                     aria-valuenow="{{ project.progress }}"
                                     aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-fill" style="width:{{ project.progress }}%;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </main>
    </div>

{% endblock %}
