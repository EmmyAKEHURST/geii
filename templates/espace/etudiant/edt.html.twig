{% extends 'layouts/espace.html.twig' %}

{% block title %}Emploi du temps — Espace Étudiant — GEII{% endblock %}

{% block content %}
    {% set activePage = 'emploi-du-temps' %}

    <div class="d-flex espace-layout-fixed">
        {{ include('espace/etudiant/_navbar.html.twig') }}

        <main class="flex-grow-1 d-flex flex-column bg-white espace-main-fixed">
            {# Mobile header #}
            <header class="d-lg-none bg-dark text-white px-3 py-2 d-flex align-items-center justify-content-between flex-shrink-0">
                <span class="fw-bold">GEII — Espace Étudiant</span>
                <button class="btn btn-sm btn-outline-secondary" type="button"
                        data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar">
                    <i class="bi bi-list"></i>
                </button>
            </header>

            {# Breadcrumb (Fil d'Ariane) #}
            <div class="px-4 py-2 border-bottom d-flex align-items-center gap-2 flex-shrink-0 bg-white espace-breadcrumb">
                <i class="bi bi-layout-sidebar text-label" style="font-size:.9rem;"></i>
                <nav aria-label="fil d'Ariane">
                    <ol class="breadcrumb mb-0" style="font-size:.875rem;">
                        <li class="breadcrumb-item">
                            <a href="{{ path('app_espace_etudiant_index') }}" class="text-label text-decoration-none">Espace étudiant</a>
                        </li>
                        <li class="breadcrumb-item active fw-medium">Emploi du temps</li>
                    </ol>
                </nav>
            </div>

            {# Contenu — remplit la hauteur restante, pas de scroll #}
            <div class="espace-content">
                <div class="d-flex align-items-center justify-content-between gap-3 mb-3 flex-shrink-0">
                    <div class="d-flex align-items-center gap-3">
                        <div class="page-icon page-icon--edt rounded-3 d-flex align-items-center justify-content-center">
                            <i class="bi bi-calendar-week fs-4 text-iut-blue"></i>
                        </div>
                        <div>
                            <h1 class="h3 mb-0 fw-bold">Emploi du temps</h1>
                            <p class="mb-0 text-muted-sm">Semaine du {{ weekStart }}</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <a href="{{ path('app_espace_etudiant_edt', {week: weekOffset - 1}) }}"
                           class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center"
                           style="width:2rem;height:2rem;padding:0;"
                           title="Semaine précédente">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                        {% if weekOffset != 0 %}
                        <a href="{{ path('app_espace_etudiant_edt') }}"
                           class="btn btn-sm btn-outline-primary"
                           style="font-size:.8rem;">
                            Aujourd'hui
                        </a>
                        {% endif %}
                        <a href="{{ path('app_espace_etudiant_edt', {week: weekOffset + 1}) }}"
                           class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center"
                           style="width:2rem;height:2rem;padding:0;"
                           title="Semaine suivante">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </div>
                </div>

                {# Grille — remplit toute la hauteur disponible #}
                <div class="border rounded-3 overflow-hidden flex-grow-1">
                    <div class="week-grid-wrap">
                        <div class="week-grid">

                            {# ── En-tête ──────────────────────────────── #}
                            <div class="week-grid-header bg-white border-bottom border-end"></div>
                            {% for day in weekdays %}
                            {% set isToday = day.key == scheduleDay %}
                            <div class="week-grid-header bg-white border-bottom {{ not loop.last ? 'border-end' : '' }} py-2 text-center {{ isToday ? 'text-iut-blue' : 'text-geii-black' }}">
                                <div class="fw-semibold" style="font-size:1rem;">{{ day.label }}</div>
                                <div style="font-size:.78rem;opacity:.7;margin-top:1px;">{{ day.date }}</div>
                                {% if isToday %}<span class="week-grid-today-dot" style="display:block;margin:2px auto 0;"></span>{% endif %}
                            </div>
                            {% endfor %}

                            {# ── Axe horaire ──────────────────────────── #}
                            <div class="week-grid-col border-end">
                                {% for hour in scheduleHours %}
                                <div class="week-grid-time-label"
                                     style="top:calc({{ hour - 9 }} * var(--hour-h) + 2px);">
                                    {{ hour }}h
                                </div>
                                {% endfor %}
                            </div>

                            {# ── Colonnes jours ───────────────────────── #}
                            {% for day in weekdays %}
                            {% set daySlots = weeklyByDay[day.key] ?? [] %}
                            {% set isToday  = day.key == scheduleDay %}

                            <div class="week-grid-col {{ not loop.last ? 'border-end' : '' }}">
                                {% if isToday %}
                                    <div class="week-grid-today-overlay"></div>
                                {% endif %}

                                {% for hour in scheduleHours %}
                                <div class="week-grid-line" style="top:calc({{ hour - 9 }} * var(--hour-h));"></div>
                                {% endfor %}

                                {% for edt in daySlots %}
                                {% set startH    = edt.dateHeureDebut|date('G') %}
                                {% set startM    = edt.dateHeureDebut|date('i') %}
                                {% set endH      = edt.dateHeureFin|date('G') %}
                                {% set endM      = edt.dateHeureFin|date('i') %}
                                {% set topOffset = (startH - 9) + startM / 60 %}
                                {% set duration  = (endH * 60 + endM - startH * 60 - startM) / 60 %}
                                <div class="course-block position-absolute rounded-2"
                                     style="top:calc({{ topOffset }} * var(--hour-h) + 2px);height:calc({{ duration }} * var(--hour-h) - 4px);left:3px;right:3px;background:#eff6ff;border-left:3px solid #3b82f6;overflow:hidden;"
                                     title="{{ edt.matiere ? edt.matiere.nom : '—' }} · {{ edt.dateHeureDebut|date("H\\hi") }}–{{ edt.dateHeureFin|date("H\\hi") }} · {{ edt.salle ?? '' }}">
                                    <div class="ps-2 pe-1 pt-1">
                                        <div class="fw-semibold lh-sm text-truncate" style="font-size:.78rem;color:#3b82f6;">
                                            {{ edt.matiere ? edt.matiere.nom : '—' }}
                                        </div>
                                        <div class="text-meta lh-sm" style="margin-top:1px;font-size:.68rem;">
                                            {{ edt.dateHeureDebut|date("H\\hi") }}–{{ edt.dateHeureFin|date("H\\hi") }}
                                            {% if duration >= 0.9 %}<br>{{ edt.salle ?? '' }}{% endif %}
                                        </div>
                                    </div>
                                </div>
                                {% endfor %}
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

{% endblock %}
