{% extends 'layouts/espace.html.twig' %}

{% block title %}Offres d'alternance — Espace Étudiant — GEII{% endblock %}

{% block content %}
    {% set activePage = 'alternance' %}

    <div class="d-flex espace-layout-scroll">
        {{ include('espace/etudiant/_navbar.html.twig') }}

        <main class="flex-grow-1 d-flex flex-column bg-white espace-main-scroll">
            {# Mobile header #}
            <header class="d-lg-none bg-dark text-white px-3 py-2 d-flex align-items-center justify-content-between flex-shrink-0">
                <span class="fw-bold">GEII — Espace Étudiant</span>
                <button class="btn btn-sm btn-outline-secondary" type="button"
                        data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar">
                    <i class="bi bi-list"></i>
                </button>
            </header>

            {# Breadcrumb (Fil d'Ariane) #}
            <div class="px-4 py-2 border-bottom d-flex align-items-center gap-2 flex-shrink-0 bg-white espace-breadcrumb">
                <i class="bi bi-layout-sidebar text-label" style="font-size:.9rem;"></i>
                <nav aria-label="fil d'ariane">
                    <ol class="breadcrumb mb-0" style="font-size:.875rem;">
                        <li class="breadcrumb-item">
                            <a href="{{ path('app_espace_etudiant_index') }}" class="text-label text-decoration-none">Espace étudiant</a>
                        </li>
                        <li class="breadcrumb-item active fw-medium">Offres d'alternance</li>
                    </ol>
                </nav>
            </div>

            <div class="espace-content-scroll">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="page-icon page-icon--alternance rounded-3 d-flex align-items-center justify-content-center">
                        <i class="bi bi-briefcase fs-4" style="color:#15803d;"></i>
                    </div>
                    <div>
                        <h1 class="h3 mb-0 fw-bold">Offres d'alternance</h1>
                        <p class="mb-0 text-muted-sm">{{ offers|length }} offres disponibles</p>
                    </div>
                </div>

                <div class="row g-3">
                    {% for offer in offers %}
                        <div class="col-md-6">
                            <div class="offer-card border rounded-3 p-4 h-100 d-flex flex-column">
                                <div class="d-flex align-items-start justify-content-between mb-3">
                                    <span class="offer-type-badge rounded-pill px-3 py-1 text-dark">
                                        Alternance
                                    </span>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="rounded-pill px-2 py-1 fw-semibold"
                                              style="font-size:.75rem;
                                                     {% if offer.statut.value == 'active' %}background:#dcfce7;color:#15803d;
                                                     {% elseif offer.statut.value == 'pourvue' %}background:#dbeafe;color:#1d4ed8;
                                                     {% else %}background:#f1f5f9;color:#64748b;{% endif %}">
                                            {{ offer.statut.value|capitalize }}
                                        </span>
                                        <span class="text-meta">{{ offer.duree }} mois</span>
                                    </div>
                                </div>
                                <h2 class="fw-bold mb-1" style="font-size:1.2rem;">{{ offer.titre }}</h2>
                                <p class="fw-semibold mb-3 text-iut-blue" style="font-size:1rem;">
                                    <i class="bi bi-building me-1"></i>{{ offer.entreprise.nom }}
                                </p>
                                <p class="flex-grow-1 mb-4 text-meta" style="font-size:1rem;">{{ offer.description }}</p>
                                <a href="#" class="btn btn-sm align-self-start text-white" style="background:var(--iut-blue);font-size:.9rem;">
                                    <i class="bi bi-eye me-1"></i> Voir les détails
                                </a>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </main>
    </div>

{% endblock %}
