{% form_theme form 'bootstrap_5_layout.html.twig' %}

{{ include('espace/personnel/_page-header.html.twig', {
    icon: icon,
    variant: variant,
    title: (isNew ? 'Nouveau ' : 'Modifier ') ~ resourceLabel,
    subtitle: isNew
        ? 'Renseignez les informations puis enregistrez.'
        : 'Mettez à jour les informations puis enregistrez.',
}) }}

<div class="row">
    <div class="col-lg-8">
        <div class="border rounded-3 p-4">
            {{ form_start(form, { attr: { novalidate: 'novalidate', class: 'd-flex flex-column gap-3' } }) }}

                {{ form_errors(form) }}
                {{ form_rest(form) }}

                <div class="d-flex gap-2 pt-2 border-top">
                    <button type="submit" class="btn btn-warning fw-semibold">
                        <i class="bi bi-check-lg me-1"></i>
                        {{ isNew ? 'Publier' : 'Enregistrer' }}
                    </button>
                    <a href="{{ path(cancelRoute, cancelParams ?? {}) }}" class="btn btn-outline-secondary">
                        Annuler
                    </a>
                </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
