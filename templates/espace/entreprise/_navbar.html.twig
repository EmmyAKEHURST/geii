{#
    Sidebar de l'Espace Entreprise — insertion professionnelle (CDC §2.2).
#}

{% set navSections = [
    {
        label: null,
        items: [
            {
                route: 'app_espace_entreprise_index',
                page: 'accueil',
                label: 'Tableau de bord',
                icon: 'bi-speedometer2'
            },
        ]
    },
    {
        label: 'Partenariat GEII',
        items: [
            {
                route: 'app_espace_entreprise_offres_alternance',
                page: 'alternance',
                label: "Offres d'alternance",
                icon: 'bi-briefcase'
            },
            {
                route: 'app_espace_entreprise_projets_tuteures',
                page: 'projets',
                label: 'Projets tuteurés',
                icon: 'bi-diagram-3'
            },
        ]
    },
    {
        label: 'Mon compte',
        items: [
            {
                route: 'app_espace_entreprise_profil',
                page: 'profil',
                label: 'Mon entreprise',
                icon: 'bi-buildings'
            },
        ]
    },
] %}

{% macro renderNavSection(section, activePage) %}
    {% if section.label %}
        <p class="px-2 mt-3 mb-2 text-secondary text-uppercase sidebar-nav-section-label">{{ section.label }}</p>
    {% endif %}
    <ul class="list-unstyled mb-0 d-flex flex-column gap-1">
        {% for item in section.items %}
            <li>
                <a href="{{ path(item.route) }}"
                   class="sidebar-link nav-link d-flex align-items-center gap-3 px-3 py-2 fw-medium {{ activePage is defined and activePage == item.page ? 'active' : '' }}">
                    <i class="bi {{ item.icon }} sidebar-nav-icon"></i>
                    <span style="font-size:1rem;">{{ item.label }}</span>
                </a>
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{% import _self as nav %}

<aside class="espace-sidebar d-none d-lg-flex flex-column bg-dark text-white">
    <div class="px-4 pt-4 pb-3">
        <div class="d-flex align-items-center gap-3">
            <span class="sidebar-brand-icon rounded-circle d-flex align-items-center justify-content-center">
                <i class="bi bi-briefcase-fill text-dark" style="font-size:1.1rem;"></i>
            </span>
            <div>
                <div class="fw-bold text-white lh-sm font-barlow" style="font-size:1rem;">GEII — IUT</div>
                <div class="text-secondary lh-sm" style="font-size:.8rem;">Espace Entreprise</div>
            </div>
        </div>
    </div>

    <div class="px-3 pb-1"><hr class="border-secondary my-0"></div>

    <nav class="px-3 py-3 flex-grow-1 overflow-auto" aria-label="Navigation principale">
        {% for section in navSections %}
            {{ nav.renderNavSection(section, activePage ?? '') }}
        {% endfor %}
    </nav>

    <div class="px-3 pb-1"><hr class="border-secondary my-0"></div>

    <div class="px-4 py-3">
        <div class="d-flex align-items-center gap-3">
            <div class="sidebar-avatar font-barlow rounded-circle d-flex align-items-center justify-content-center fw-bold text-dark">
                {{ company.companyName|slice(0, 2)|upper }}
            </div>
            <div class="overflow-hidden flex-grow-1">
                <div class="fw-semibold text-white text-truncate" style="font-size:1rem;">
                    {{ company.companyName }}
                </div>
                <div class="text-secondary text-truncate" style="font-size:.8rem;">{{ company.email }}</div>
            </div>
            <a href="{{ path('app_logout') }}" class="btn btn-sm btn-outline-secondary flex-shrink-0"
               title="Déconnexion" style="padding:.2rem .45rem;">
                <i class="bi bi-box-arrow-right"></i>
            </a>
        </div>
    </div>
</aside>

<div class="offcanvas offcanvas-start bg-dark text-white" tabindex="-1" id="mobileSidebarEntreprise"
     aria-labelledby="mobileSidebarEntrepriseLabel">
    <div class="offcanvas-header border-bottom border-secondary">
        <div class="d-flex align-items-center gap-3">
            <span class="sidebar-avatar--sm rounded-circle d-flex align-items-center justify-content-center"
                  style="background:var(--geii-yellow);">
                <i class="bi bi-briefcase-fill text-dark"></i>
            </span>
            <span id="mobileSidebarEntrepriseLabel" class="fw-bold font-barlow">GEII — Entreprise</span>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column p-0">
        <nav class="px-3 py-3 flex-grow-1 overflow-auto">
            {% for section in navSections %}
                {{ nav.renderNavSection(section, activePage ?? '') }}
            {% endfor %}
        </nav>
        <div class="border-top border-secondary px-4 py-3">
            <div class="fw-semibold text-white text-truncate">{{ company.companyName }}</div>
            <div class="text-secondary" style="font-size:.8rem;">{{ company.email }}</div>
        </div>
    </div>
</div>
