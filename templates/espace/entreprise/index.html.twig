{% extends 'layouts/espace-entreprise.html.twig' %}

{% block title %}Tableau de bord — Espace Entreprise — GEII{% endblock %}

{% set activePage = 'accueil' %}
{% set breadcrumb = [
    { label: 'Espace entreprise' },
    { label: 'Tableau de bord' },
] %}

{% block page_content %}
    {{ include('espace/personnel/_page-header.html.twig', {
        icon: 'bi-speedometer2',
        variant: 'dashboard',
        title: entreprise.nom,
        subtitle: entreprise.secteur ~ ' — Gérez vos offres et projets tuteurés',
    }) }}

    <section aria-labelledby="stats-title" class="mb-4">
        <h2 id="stats-title" class="visually-hidden">Statistiques</h2>
        <div class="row g-3">
            {% for stat in stats %}
                <div class="col-sm-6">
                    <a href="{{ path(stat.route) }}" class="text-decoration-none">
                        <div class="dashboard-stat border rounded-3 p-3 h-100 d-flex align-items-center gap-3">
                            <div class="page-icon page-icon--{{ stat.variant }} rounded-3 d-flex align-items-center justify-content-center flex-shrink-0">
                                <i class="bi {{ stat.icon }} fs-5"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-geii-black" style="font-size:1.5rem;line-height:1;">{{ stat.value }}</div>
                                <div class="text-meta">{{ stat.label }}</div>
                            </div>
                        </div>
                    </a>
                </div>
            {% endfor %}
        </div>
    </section>

    <div class="row g-4">
        <div class="col-lg-6">
            <section class="border rounded-3 h-100" aria-labelledby="recent-offers-title">
                <div class="px-4 py-3 border-bottom d-flex justify-content-between align-items-center">
                    <span id="recent-offers-title" class="fw-semibold text-geii-black">Dernières offres</span>
                    <a href="{{ path('app_espace_entreprise_offres_alternance_new') }}" class="btn btn-sm btn-warning fw-semibold">Nouvelle</a>
                </div>
                <ul class="list-group list-group-flush">
                    {% for offer in recentOffers %}
                        <li class="list-group-item px-4 py-3 d-flex justify-content-between align-items-center">
                            <span class="fw-medium">{{ offer.titre }}</span>
                            <a href="{{ path('app_espace_entreprise_offres_alternance_edit', { id: offer.id }) }}" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </li>
                    {% else %}
                        <li class="list-group-item px-4 py-4 text-center text-meta">
                            Aucune offre. <a href="{{ path('app_espace_entreprise_offres_alternance_new') }}">Publier la première</a>.
                        </li>
                    {% endfor %}
                </ul>
            </section>
        </div>
        <div class="col-lg-6">
            <section class="border rounded-3 h-100" aria-labelledby="recent-projects-title">
                <div class="px-4 py-3 border-bottom d-flex justify-content-between align-items-center">
                    <span id="recent-projects-title" class="fw-semibold text-geii-black">Derniers projets</span>
                    <a href="{{ path('app_espace_entreprise_projets_tuteures_new') }}" class="btn btn-sm btn-warning fw-semibold">Nouveau</a>
                </div>
                <ul class="list-group list-group-flush">
                    {% for project in recentProjects %}
                        <li class="list-group-item px-4 py-3 d-flex justify-content-between align-items-center">
                            <span class="fw-medium">{{ project.titre }}</span>
                            <a href="{{ path('app_espace_entreprise_projets_tuteures_edit', { id: project.id }) }}" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </li>
                    {% else %}
                        <li class="list-group-item px-4 py-4 text-center text-meta">
                            Aucun projet. <a href="{{ path('app_espace_entreprise_projets_tuteures_new') }}">Proposer le premier</a>.
                        </li>
                    {% endfor %}
                </ul>
            </section>
        </div>
    </div>
{% endblock %}
