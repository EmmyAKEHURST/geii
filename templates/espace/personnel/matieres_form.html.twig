{% extends 'layouts/espace-personnel.html.twig' %}

{% block title %}
    {{ isNew ? 'Nouvelle matière' : 'Modifier la matière' }} — Espace Personnel — GEII
{% endblock %}

{% set activePage = 'matieres' %}
{% set breadcrumb = [
    { label: 'Espace personnel', route: 'app_espace_personnel_index' },
    { label: 'Matières', route: 'app_espace_personnel_matieres' },
    { label: isNew ? 'Nouvelle' : matiere.nom },
] %}

{% block page_content %}
    {{ include('espace/personnel/_form-layout.html.twig', {
        form: form,
        icon: 'bi-bookmark-star',
        variant: 'matieres',
        resourceLabel: 'matière',
        isNew: isNew,
        cancelRoute: 'app_espace_personnel_matieres',
    }) }}
{% endblock %}
