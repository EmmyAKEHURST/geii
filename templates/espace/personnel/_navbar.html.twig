{#
    Sidebar de l'Espace Personnel.

    Structurée en sections (CDC §2.2) pour refléter la matrice des droits :
        • Tableau de bord
        • Administration (exclusif Personnel) — comptes, annuaires, contenus de référence
        • Pédagogie                              — comme l'enseignant
        • Insertion professionnelle             — comme l'entreprise
#}

{% set navSections = [
    {
        label: null,
        items: [
            {
                route: 'app_espace_personnel_index',
                page: 'accueil',
                label: 'Tableau de bord',
                icon: 'bi-speedometer2'
            },
        ]
    },
    {
        label: 'Administration',
        items: [
            {
                route: 'app_espace_personnel_comptes',
                page: 'comptes',
                label: 'Comptes & rôles',
                icon: 'bi-shield-lock'
            }, {
                route: 'app_espace_personnel_etudiants',
                page: 'etudiants',
                label: 'Étudiants',
                icon: 'bi-mortarboard'
            },
        {
                route: 'app_espace_personnel_enseignants',
                page: 'enseignants',
                label: 'Enseignants',
                icon: 'bi-person-video3'
            }, {
                route: 'app_espace_personnel_personnels',
                page: 'personnels',
                label: 'Personnel',
                icon: 'bi-person-badge' },
            { route: 'app_espace_personnel_entreprises',
                page: 'entreprises',
                label: 'Entreprises',
                icon: 'bi-buildings' },
            { route: 'app_espace_personnel_matieres',
                page: 'matieres',
                label: 'Matières',
                icon: 'bi-bookmark-star' },
        ]
    },
    {
        label: 'Pédagogie',
        items: [
            { route: 'app_espace_personnel_notes',    page: 'notes',    label: 'Notes',             icon: 'bi-clipboard2-check' },
            { route: 'app_espace_personnel_edt',      page: 'edt',      label: 'Emplois du temps',  icon: 'bi-calendar-week' },
            { route: 'app_espace_personnel_supports', page: 'supports', label: 'Supports de cours', icon: 'bi-file-earmark-pdf' },
        ]
    },
    {
        label: 'Insertion professionnelle',
        items: [
            { route: 'app_espace_personnel_offres_alternance', page: 'alternance', label: "Offres d'alternance", icon: 'bi-briefcase' },
            { route: 'app_espace_personnel_projets_tuteures',  page: 'projets',    label: 'Projets tuteurés',     icon: 'bi-kanban' },
        ]
    },
] %}

{# Macro réutilisée pour les deux variantes (desktop + offcanvas mobile) #}
{% macro renderNavSection(section, activePage) %}
    {% if section.label %}
        <p class="px-2 mt-3 mb-2 text-secondary text-uppercase sidebar-nav-section-label">{{ section.label }}</p>
    {% endif %}
    <ul class="list-unstyled mb-0 d-flex flex-column gap-1">
        {% for item in section.items %}
            <li>
                <a href="{{ path(item.route) }}"
                   class="sidebar-link nav-link d-flex align-items-center gap-3 px-3 py-2 fw-medium {{ activePage is defined and activePage == item.page ? 'active' : '' }}">
                    <i class="bi {{ item.icon }} sidebar-nav-icon"></i>
                    <span style="font-size:1rem;">{{ item.label }}</span>
                </a>
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{% import _self as nav %}

{# ── Sidebar desktop ─────────────────────────────────────────────────── #}
<aside class="espace-sidebar d-none d-lg-flex flex-column bg-dark text-white">
    <div class="px-4 pt-4 pb-3">
        <div class="d-flex align-items-center gap-3">
            <span class="sidebar-brand-icon rounded-circle d-flex align-items-center justify-content-center">
                <i class="bi bi-shield-fill-check text-dark" style="font-size:1.1rem;"></i>
            </span>
            <div>
                <div class="fw-bold text-white lh-sm font-barlow" style="font-size:1rem;">GEII — IUT</div>
                <div class="text-secondary lh-sm" style="font-size:.8rem;">Espace Personnel</div>
            </div>
        </div>
    </div>

    <div class="px-3 pb-1"><hr class="border-secondary my-0"></div>

    <nav class="px-3 py-3 flex-grow-1 overflow-auto" aria-label="Navigation principale">
        {% for section in navSections %}
            {{ nav.renderNavSection(section, activePage ?? '') }}
        {% endfor %}
    </nav>

    <div class="px-3 pb-1"><hr class="border-secondary my-0"></div>

    <div class="px-4 py-3">
        <div class="d-flex align-items-center gap-3">
            <div class="sidebar-avatar font-barlow rounded-circle d-flex align-items-center justify-content-center fw-bold text-dark">
                {{ staff.firstName|slice(0,1) }}{{ staff.lastName|slice(0,1) }}
            </div>
            <div class="overflow-hidden flex-grow-1">
                <div class="fw-semibold text-white text-truncate" style="font-size:1rem;">
                    {{ staff.lastName }} {{ staff.firstName }}
                </div>
                <div class="text-secondary text-truncate" style="font-size:.8rem;">{{ staff.function }}</div>
            </div>
            <a href="{{ path('app_logout') }}" class="btn btn-sm btn-outline-secondary flex-shrink-0"
               title="Déconnexion" style="padding:.2rem .45rem;">
                <i class="bi bi-box-arrow-right"></i>
            </a>
        </div>
    </div>
</aside>

{# ── Drawer mobile (Bootstrap Offcanvas) ─────────────────────────────── #}
<div class="offcanvas offcanvas-start bg-dark text-white" tabindex="-1" id="mobileSidebar"
     aria-labelledby="mobileSidebarLabel">
    <div class="offcanvas-header border-bottom border-secondary">
        <div class="d-flex align-items-center gap-3">
            <span class="sidebar-avatar--sm rounded-circle d-flex align-items-center justify-content-center"
                  style="background:var(--geii-yellow);">
                <i class="bi bi-shield-fill-check text-dark"></i>
            </span>
            <span id="mobileSidebarLabel" class="fw-bold font-barlow">GEII — IUT</span>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column p-0">
        <nav class="px-3 py-3 flex-grow-1 overflow-auto">
            {% for section in navSections %}
                {{ nav.renderNavSection(section, activePage ?? '') }}
            {% endfor %}
        </nav>
        <div class="border-top border-secondary px-4 py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="sidebar-avatar font-barlow rounded-circle d-flex align-items-center justify-content-center fw-bold text-dark">
                    {{ staff.firstName|slice(0,1) }}{{ staff.lastName|slice(0,1) }}
                </div>
                <div class="overflow-hidden">
                    <div class="fw-semibold text-white text-truncate" style="font-size:1rem;">
                        {{ staff.lastName }} {{ staff.firstName }}
                    </div>
                    <div class="text-secondary" style="font-size:.8rem;">{{ staff.function }}</div>
                </div>
            </div>
        </div>
    </div>
</div>
