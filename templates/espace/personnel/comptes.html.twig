{% extends 'layouts/espace-personnel.html.twig' %}

{% import 'espace/personnel/_macros.html.twig' as ui %}

{% block title %}Comptes & rôles — Espace Personnel — GEII{% endblock %}

{% set activePage = 'comptes' %}
{% set breadcrumb = [
    { label: 'Espace personnel', route: 'app_espace_personnel_index' },
    { label: 'Administration' },
    { label: 'Comptes & rôles' },
] %}

{% set roleLabels = {
    'ROLE_ETUDIANT': 'Étudiant',
    'ROLE_ENSEIGNANT': 'Enseignant',
    'ROLE_ENTREPRISE': 'Entreprise',
    'ROLE_PERSONNEL': 'Personnel',
    'ROLE_USER': 'Utilisateur',
} %}

{% block page_content %}
    {{ include('espace/personnel/_page-header.html.twig', {
        icon: 'bi-shield-lock',
        variant: 'comptes',
        title: 'Comptes & rôles',
        subtitle: accounts|length ~ ' compte' ~ (accounts|length > 1 ? 's' : '') ~ ' enregistré' ~ (accounts|length > 1 ? 's' : ''),
    }) }}

    {{ ui.toolbar('Rechercher un compte par email…', 'Nouveau compte', 'app_espace_personnel_comptes_new') }}

    <div class="border rounded-3 overflow-hidden">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="px-4 py-3 fw-semibold border-bottom" style="font-size:1rem;">Email</th>
                    <th class="px-4 py-3 fw-semibold border-bottom d-none d-md-table-cell" style="font-size:1rem;">Profil lié</th>
                    <th class="px-4 py-3 fw-semibold border-bottom" style="font-size:1rem;">Rôles</th>
                    <th class="px-4 py-3 fw-semibold border-bottom d-none d-sm-table-cell text-center" style="font-size:1rem;">Vérifié</th>
                    <th class="px-4 py-3 fw-semibold border-bottom text-end" style="font-size:1rem;width:120px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for account in accounts %}
                    <tr>
                        <td class="px-4 py-3 fw-medium text-geii-black">
                            <i class="bi bi-envelope me-2 text-label"></i>{{ account.email }}
                            {% if account == app.user %}
                                <span class="role-badge rounded-pill px-2 py-1 ms-2">vous</span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 d-none d-md-table-cell text-meta">
                            {% if account.etudiant %}
                                <i class="bi bi-mortarboard me-1 text-iut-blue"></i>{{ account.etudiant }}
                            {% elseif account.enseignant %}
                                <i class="bi bi-person-video3 me-1" style="color:#0f766e;"></i>{{ account.enseignant }}
                            {% elseif account.personnel %}
                                <i class="bi bi-person-badge me-1" style="color:#b45309;"></i>{{ account.personnel }}
                            {% else %}
                                <span class="text-label">—</span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3">
                            <div class="d-flex flex-wrap gap-1">
                                {% for role in account.roles %}
                                    {% if role != 'ROLE_USER' %}
                                        <span class="role-badge rounded-pill px-2 py-1">{{ roleLabels[role] ?? role }}</span>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </td>
                        <td class="px-4 py-3 d-none d-sm-table-cell text-center">
                            {% if account.isVerified %}
                                <i class="bi bi-check-circle-fill" style="color:#15803d;" aria-label="Compte vérifié"></i>
                            {% else %}
                                <i class="bi bi-exclamation-circle-fill" style="color:#b45309;" aria-label="Non vérifié"></i>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 text-end">
                            {{ ui.rowActions(
                                'app_espace_personnel_comptes_edit',
                                'app_espace_personnel_comptes_delete',
                                { id: account.id },
                                'delete-compte-' ~ account.id,
                                'Supprimer le compte ' ~ account.email ~ ' ? Cela supprimera AUSSI le profil lié (étudiant/enseignant/personnel) et toutes ses notes / projets associés.'
                            ) }}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="px-4 py-5 text-center text-meta">Aucun compte. <a href="{{ path('app_espace_personnel_comptes_new') }}">Créer le premier</a>.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
