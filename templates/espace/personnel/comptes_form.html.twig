{% extends 'layouts/espace-personnel.html.twig' %}

{% block title %}
    {{ isNew ? 'Nouveau compte' : 'Modifier le compte' }} — Espace Personnel — GEII
{% endblock %}

{% set activePage = 'comptes' %}
{% set breadcrumb = [
    { label: 'Espace personnel', route: 'app_espace_personnel_index' },
    { label: 'Comptes & rôles', route: 'app_espace_personnel_comptes' },
    { label: isNew ? 'Nouveau' : 'Modifier' },
] %}

{% block page_content %}
    {{ include('espace/personnel/_form-layout.html.twig', {
        form: form,
        icon: 'bi-shield-lock',
        variant: 'comptes',
        resourceLabel: 'compte',
        isNew: isNew,
        cancelRoute: 'app_espace_personnel_comptes',
    }) }}
{% endblock %}
