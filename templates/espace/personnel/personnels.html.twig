{% extends 'layouts/espace-personnel.html.twig' %}
{% import 'espace/personnel/_macros.html.twig' as ui %}

{% block title %}Personnel — Espace Personnel — GEII{% endblock %}

{% set activePage = 'personnels' %}
{% set breadcrumb = [
    { label: 'Espace personnel', route: 'app_espace_personnel_index' },
    { label: 'Administration' },
    { label: 'Personnel' },
] %}

{% block page_content %}
    {{ include('espace/personnel/_page-header.html.twig', {
        icon: 'bi-person-badge',
        variant: 'personnels',
        title: 'Personnel',
        subtitle: personnels|length ~ ' membre' ~ (personnels|length > 1 ? 's' : '') ~ ' du personnel',
    }) }}

    {{ ui.toolbar('Rechercher un membre du personnel…', 'Nouveau membre', 'app_espace_personnel_personnels_new') }}

    <div class="border rounded-3 overflow-hidden">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="px-4 py-3 fw-semibold border-bottom" style="font-size:1rem;">Nom</th>
                    <th class="px-4 py-3 fw-semibold border-bottom d-none d-md-table-cell" style="font-size:1rem;">Prénom</th>
                    <th class="px-4 py-3 fw-semibold border-bottom" style="font-size:1rem;">Fonction</th>
                    <th class="px-4 py-3 fw-semibold border-bottom d-none d-sm-table-cell text-center" style="font-size:1rem;">Responsable</th>
                    <th class="px-4 py-3 fw-semibold border-bottom d-none d-lg-table-cell" style="font-size:1rem;">Compte</th>
                    <th class="px-4 py-3 fw-semibold border-bottom text-end" style="font-size:1rem;width:120px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for p in personnels %}
                    <tr>
                        <td class="px-4 py-3 fw-medium text-geii-black">{{ p.nom }}</td>
                        <td class="px-4 py-3 d-none d-md-table-cell text-geii-black">{{ p.prenom }}</td>
                        <td class="px-4 py-3 text-meta">{{ p.fonction }}</td>
                        <td class="px-4 py-3 d-none d-sm-table-cell text-center">
                            {% if p.admin %}
                                <i class="bi bi-check-circle-fill" style="color:#15803d;" aria-label="Responsable"></i>
                            {% else %}
                                <i class="bi bi-dash-circle text-label" aria-label="Non"></i>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 d-none d-lg-table-cell text-meta">
                            {% if p.compte %}
                                <i class="bi bi-envelope me-1"></i>{{ p.compte.email }}
                            {% else %}
                                <span class="text-label">—</span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 text-end">
                            {{ ui.rowActions(
                                'app_espace_personnel_personnels_edit',
                                'app_espace_personnel_personnels_delete',
                                { id: p.id },
                                'delete-personnel-' ~ p.id,
                                'Supprimer définitivement ' ~ p.nom ~ ' ' ~ p.prenom ~ ' ?'
                            ) }}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="px-4 py-5 text-center text-meta">Aucun membre du personnel. <a href="{{ path('app_espace_personnel_personnels_new') }}">Créer le premier</a>.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
