{% extends 'layouts/espace-personnel.html.twig' %}

{% import 'espace/personnel/_macros.html.twig' as ui %}

{% block title %}Projets tuteurés — Espace Personnel — GEII{% endblock %}

{% set activePage = 'projets' %}
{% set breadcrumb = [
    { label: 'Espace personnel', route: 'app_espace_personnel_index' },
    { label: 'Insertion professionnelle' },
    { label: 'Projets tuteurés' },
] %}

{% block page_content %}
    {{ include('espace/personnel/_page-header.html.twig', {
        icon: 'bi-kanban',
        variant: 'projets',
        title: 'Projets tuteurés',
        subtitle: projects|length ~ ' projet' ~ (projects|length > 1 ? 's' : '') ~ ' référencé' ~ (projects|length > 1 ? 's' : ''),
    }) }}

    {{ ui.toolbar('Rechercher un projet…', 'Nouveau projet', 'app_espace_personnel_projets_tuteures_new') }}

    <div class="border rounded-3 overflow-hidden">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="px-4 py-3 fw-semibold border-bottom" style="font-size:1rem;">Titre</th>
                    <th class="px-4 py-3 fw-semibold border-bottom" style="font-size:1rem;">Entreprise</th>
                    <th class="px-4 py-3 fw-semibold border-bottom d-none d-md-table-cell" style="font-size:1rem;">Tuteur</th>
                    <th class="px-4 py-3 fw-semibold border-bottom d-none d-sm-table-cell text-center" style="font-size:1rem;">Année</th>
                    <th class="px-4 py-3 fw-semibold border-bottom" style="font-size:1rem;">Statut</th>
                    <th class="px-4 py-3 fw-semibold border-bottom text-end" style="font-size:1rem;width:120px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for project in projects %}
                    <tr>
                        <td class="px-4 py-3 fw-medium text-geii-black">{{ project.titre }}</td>
                        <td class="px-4 py-3 text-meta">
                            {% if project.entreprise %}
                                <i class="bi bi-building me-1 text-iut-blue"></i>{{ project.entreprise.nom }}
                            {% else %}
                                <span class="text-label">—</span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 d-none d-md-table-cell text-meta">
                            {% if project.enseignantTuteur %}
                                <i class="bi bi-person-video3 me-1" style="color:#0f766e;"></i>{{ project.enseignantTuteur.nom }} {{ project.enseignantTuteur.prenom }}
                            {% else %}
                                <span class="text-label">—</span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 d-none d-sm-table-cell text-center text-meta">{{ project.annee }}</td>
                        <td class="px-4 py-3">{{ ui.statusBadge(project.statut) }}</td>
                        <td class="px-4 py-3 text-end">
                            {{ ui.rowActions(
                                'app_espace_personnel_projets_tuteures_edit',
                                'app_espace_personnel_projets_tuteures_delete',
                                { id: project.id },
                                'delete-projet-' ~ project.id,
                                'Supprimer définitivement le projet ' ~ project.titre ~ ' ?'
                            ) }}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="px-4 py-5 text-center text-meta">Aucun projet. <a href="{{ path('app_espace_personnel_projets_tuteures_new') }}">Créer le premier</a>.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
