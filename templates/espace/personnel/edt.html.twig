{% extends 'layouts/espace-personnel.html.twig' %}

{% import 'espace/personnel/_macros.html.twig' as ui %}

{% block title %}Emplois du temps — Espace Personnel — GEII{% endblock %}

{% set activePage = 'edt' %}
{% set breadcrumb = [
    { label: 'Espace personnel', route: 'app_espace_personnel_index' },
    { label: 'Pédagogie' },
    { label: 'Emplois du temps' },
] %}

{% block page_content %}
    {{ include('espace/personnel/_page-header.html.twig', {
        icon: 'bi-calendar-week',
        variant: 'edt',
        title: 'Emplois du temps',
        subtitle: schedules|length ~ ' créneau' ~ (schedules|length > 1 ? 'x' : '') ~ ' enregistré' ~ (schedules|length > 1 ? 's' : ''),
    }) }}

    {{ ui.toolbar('Rechercher un créneau (matière, salle)…', 'Nouveau créneau', 'app_espace_personnel_edt_new') }}

    <div class="border rounded-3 overflow-hidden">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="px-4 py-3 fw-semibold border-bottom" style="font-size:1rem;">Date</th>
                    <th class="px-4 py-3 fw-semibold border-bottom" style="font-size:1rem;">Horaires</th>
                    <th class="px-4 py-3 fw-semibold border-bottom" style="font-size:1rem;">Matière</th>
                    <th class="px-4 py-3 fw-semibold border-bottom d-none d-sm-table-cell" style="font-size:1rem;">Salle</th>
                    <th class="px-4 py-3 fw-semibold border-bottom text-end" style="font-size:1rem;width:120px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for slot in schedules %}
                    <tr>
                        <td class="px-4 py-3 fw-medium text-geii-black">{{ slot.dateHeureDebut|date('d/m/Y') }}</td>
                        <td class="px-4 py-3 text-iut-blue fw-semibold" style="font-variant-numeric:tabular-nums;">
                            {{ slot.dateHeureDebut|date('H:i') }} – {{ slot.dateHeureFin|date('H:i') }}
                        </td>
                        <td class="px-4 py-3 text-geii-black">{{ slot.matiere ? slot.matiere.nom : '—' }}</td>
                        <td class="px-4 py-3 d-none d-sm-table-cell text-meta">
                            <i class="bi bi-geo-alt me-1"></i>{{ slot.salle }}
                        </td>
                        <td class="px-4 py-3 text-end">
                            {{ ui.rowActions(
                                'app_espace_personnel_edt_edit',
                                'app_espace_personnel_edt_delete',
                                { id: slot.id },
                                'delete-edt-' ~ slot.id,
                                'Supprimer définitivement ce créneau ?'
                            ) }}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="px-4 py-5 text-center text-meta">Aucun créneau. <a href="{{ path('app_espace_personnel_edt_new') }}">Créer le premier</a>.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
