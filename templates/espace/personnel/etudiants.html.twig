{% extends 'layouts/espace-personnel.html.twig' %}

{% import 'espace/personnel/_macros.html.twig' as ui %}

{% block title %}Étudiants — Espace Personnel — GEII{% endblock %}

{% set activePage = 'etudiants' %}
{% set breadcrumb = [
    { label: 'Espace personnel', route: 'app_espace_personnel_index' },
    { label: 'Administration' },
    { label: 'Étudiants' },
] %}

{% block page_content %}
    {{ include('espace/personnel/_page-header.html.twig', {
        icon: 'bi-mortarboard',
        variant: 'etudiants',
        title: 'Étudiants',
        subtitle: students|length ~ ' étudiant' ~ (students|length > 1 ? 's' : '') ~ ' inscrit' ~ (students|length > 1 ? 's' : ''),
    }) }}

    {{ ui.toolbar('Rechercher un étudiant…', 'Nouvel étudiant', 'app_espace_personnel_etudiants_new') }}

    <div class="border rounded-3 overflow-hidden">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="px-4 py-3 fw-semibold border-bottom" style="font-size:1rem;">N° étudiant</th>
                    <th class="px-4 py-3 fw-semibold border-bottom" style="font-size:1rem;">Nom</th>
                    <th class="px-4 py-3 fw-semibold border-bottom d-none d-md-table-cell" style="font-size:1rem;">Prénom</th>
                    <th class="px-4 py-3 fw-semibold border-bottom d-none d-sm-table-cell" style="font-size:1rem;">Année</th>
                    <th class="px-4 py-3 fw-semibold border-bottom d-none d-lg-table-cell" style="font-size:1rem;">Compte</th>
                    <th class="px-4 py-3 fw-semibold border-bottom text-end" style="font-size:1rem;width:120px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for student in students %}
                    <tr>
                        <td class="px-4 py-3 text-meta" style="font-variant-numeric:tabular-nums;">{{ student.numEtudiant }}</td>
                        <td class="px-4 py-3 fw-medium text-geii-black">{{ student.nom }}</td>
                        <td class="px-4 py-3 d-none d-md-table-cell text-geii-black">{{ student.prenom }}</td>
                        <td class="px-4 py-3 d-none d-sm-table-cell text-meta">{{ student.annee }}</td>
                        <td class="px-4 py-3 d-none d-lg-table-cell text-meta">
                            {% if student.compte %}
                                <i class="bi bi-envelope me-1"></i>{{ student.compte.email }}
                            {% else %}
                                <span class="text-label">—</span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 text-end">
                            {{ ui.rowActions(
                                'app_espace_personnel_etudiants_edit',
                                'app_espace_personnel_etudiants_delete',
                                { numEtudiant: student.numEtudiant },
                                'delete-etudiant-' ~ student.numEtudiant,
                                "Supprimer l'étudiant " ~ student.nom ~ ' ' ~ student.prenom ~ ' ? Cela supprimera AUSSI toutes ses notes.'
                            ) }}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="px-4 py-5 text-center text-meta">Aucun étudiant. <a href="{{ path('app_espace_personnel_etudiants_new') }}">Créer le premier</a>.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
