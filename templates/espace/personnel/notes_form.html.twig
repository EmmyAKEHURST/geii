{% extends 'layouts/espace-personnel.html.twig' %}

{% block title %}
    {{ isNew ? 'Nouvelle note' : 'Modifier la note' }} — Espace Personnel — GEII
{% endblock %}

{% set activePage = 'notes' %}
{% set breadcrumb = [
    { label: 'Espace personnel', route: 'app_espace_personnel_index' },
    { label: 'Notes', route: 'app_espace_personnel_notes' },
    { label: isNew ? 'Nouvelle' : 'Note #' ~ note.id },
] %}

{% block page_content %}
    {{ include('espace/personnel/_form-layout.html.twig', {
        form: form,
        icon: 'bi-clipboard2-check',
        variant: 'notes',
        resourceLabel: 'note',
        isNew: isNew,
        cancelRoute: 'app_espace_personnel_notes',
    }) }}
{% endblock %}
