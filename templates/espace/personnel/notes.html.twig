{% extends 'layouts/espace-personnel.html.twig' %}
{% import 'espace/personnel/_macros.html.twig' as ui %}

{% block title %}Notes — Espace Personnel — GEII{% endblock %}

{% set activePage = 'notes' %}
{% set breadcrumb = [
    { label: 'Espace personnel', route: 'app_espace_personnel_index' },
    { label: 'Pédagogie' },
    { label: 'Notes' },
] %}

{% block page_content %}
    {{ include('espace/personnel/_page-header.html.twig', {
        icon: 'bi-clipboard2-check',
        variant: 'notes',
        title: 'Saisie des notes',
        subtitle: grades|length ~ ' note' ~ (grades|length > 1 ? 's' : '') ~ ' enregistrée' ~ (grades|length > 1 ? 's' : ''),
    }) }}

    {{ ui.toolbar('Rechercher une note (matière)…', 'Nouvelle note', 'app_espace_personnel_notes_new') }}

    <div class="border rounded-3 overflow-hidden">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="px-4 py-3 fw-semibold border-bottom" style="font-size:1rem;">Étudiant</th>
                    <th class="px-4 py-3 fw-semibold border-bottom" style="font-size:1rem;">Matière</th>
                    <th class="px-4 py-3 fw-semibold border-bottom" style="font-size:1rem;">Note</th>
                    <th class="px-4 py-3 fw-semibold border-bottom d-none d-md-table-cell" style="font-size:1rem;">Commentaire</th>
                    <th class="px-4 py-3 fw-semibold border-bottom text-end" style="font-size:1rem;width:120px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for grade in grades %}
                    <tr>
                        <td class="px-4 py-3 fw-medium text-geii-black">
                            {% if grade.etudiant %}
                                <i class="bi bi-mortarboard me-1 text-iut-blue"></i>{{ grade.etudiant.nom }} {{ grade.etudiant.prenom }}
                                <div class="text-meta" style="font-size:.8rem;">{{ grade.etudiant.numEtudiant }}</div>
                            {% else %}
                                <span class="text-label">— étudiant supprimé —</span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 text-meta">
                            {% if grade.matiere %}
                                {{ grade.matiere.nom }}
                            {% else %}
                                <span class="text-label">—</span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3">
                            <span class="grade-pill rounded-pill px-3 py-1 fw-semibold {{ grade.valeur >= 14 ? 'grade-pill--good' : (grade.valeur >= 10 ? 'grade-pill--medium' : 'grade-pill--bad') }}">
                                {{ grade.valeur|number_format(2) }}&nbsp;/&nbsp;20
                            </span>
                        </td>
                        <td class="px-4 py-3 d-none d-md-table-cell text-meta text-truncate" style="max-width:480px;">{{ grade.commentaire }}</td>
                        <td class="px-4 py-3 text-end">
                            {{ ui.rowActions(
                                'app_espace_personnel_notes_edit',
                                'app_espace_personnel_notes_delete',
                                { id: grade.id },
                                'delete-note-' ~ grade.id,
                                'Supprimer définitivement cette note ?'
                            ) }}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="px-4 py-5 text-center text-meta">Aucune note. <a href="{{ path('app_espace_personnel_notes_new') }}">Créer la première</a>.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
