{% extends 'layouts/espace-personnel.html.twig' %}

{% block title %}Mot de passe — {{ compte.email }} — Espace Personnel — GEII{% endblock %}

{% set activePage = 'comptes' %}
{% set breadcrumb = [
    { label: 'Espace personnel', route: 'app_espace_personnel_index' },
    { label: 'Comptes & rôles', route: 'app_espace_personnel_comptes' },
    { label: 'Mot de passe' },
] %}

{% block page_content %}
    {{ include('espace/personnel/_form-layout.html.twig', {
        form: form,
        icon: 'bi-lock',
        variant: 'comptes',
        titleOverride: 'Modifier le mot de passe',
        subtitleOverride: compte.email,
        submitLabel: 'Mettre à jour le mot de passe',
        cancelRoute: 'app_espace_personnel_comptes',
    }) }}
{% endblock %}
