{% extends 'layouts/espace-personnel.html.twig' %}

{% import 'espace/personnel/_macros.html.twig' as ui %}

{% block title %}Matières — Espace Personnel — GEII{% endblock %}

{% set activePage = 'matieres' %}
{% set breadcrumb = [
    { label: 'Espace personnel', route: 'app_espace_personnel_index' },
    { label: 'Administration' },
    { label: 'Matières' },
] %}

{% block page_content %}
    {{ include('espace/personnel/_page-header.html.twig', {
        icon: 'bi-bookmark-star',
        variant: 'matieres',
        title: 'Matières',
        subtitle: subjects|length ~ ' matière' ~ (subjects|length > 1 ? 's' : '') ~ ' enregistrée' ~ (subjects|length > 1 ? 's' : ''),
    }) }}

    {{ ui.toolbar('Rechercher une matière…', 'Nouvelle matière', 'app_espace_personnel_matieres_new') }}

    <div class="border rounded-3 overflow-hidden">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="px-4 py-3 fw-semibold border-bottom" style="font-size:1rem;">Nom</th>
                    <th class="px-4 py-3 fw-semibold border-bottom d-none d-sm-table-cell text-center" style="font-size:1rem;">Créneaux EDT</th>
                    <th class="px-4 py-3 fw-semibold border-bottom text-end" style="font-size:1rem;width:120px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for subject in subjects %}
                    <tr>
                        <td class="px-4 py-3 fw-medium text-geii-black">{{ subject.nom }}</td>
                        <td class="px-4 py-3 d-none d-sm-table-cell text-center">
                            <span class="role-badge rounded-pill px-2 py-1">{{ subject.emploiDuTemps|length }}</span>
                        </td>
                        <td class="px-4 py-3 text-end">
                            {{ ui.rowActions(
                                'app_espace_personnel_matieres_edit',
                                'app_espace_personnel_matieres_delete',
                                { id: subject.id },
                                'delete-matiere-' ~ subject.id,
                                'Supprimer la matière ' ~ subject.nom ~ ' ? Cela supprimera AUSSI toutes les notes liées à cette matière.'
                            ) }}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="3" class="px-4 py-5 text-center text-meta">Aucune matière. <a href="{{ path('app_espace_personnel_matieres_new') }}">Créer la première</a>.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
