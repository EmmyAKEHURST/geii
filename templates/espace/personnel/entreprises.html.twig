{% extends 'layouts/espace-personnel.html.twig' %}

{% import 'espace/personnel/_macros.html.twig' as ui %}

{% block title %}Entreprises partenaires — Espace Personnel — GEII{% endblock %}

{% set activePage = 'entreprises' %}
{% set breadcrumb = [
    { label: 'Espace personnel', route: 'app_espace_personnel_index' },
    { label: 'Administration' },
    { label: 'Entreprises' },
] %}

{% block page_content %}
    {{ include('espace/personnel/_page-header.html.twig', {
        icon: 'bi-buildings',
        variant: 'entreprises',
        title: 'Entreprises partenaires',
        subtitle: companies|length ~ ' entreprise' ~ (companies|length > 1 ? 's' : '') ~ ' référencée' ~ (companies|length > 1 ? 's' : ''),
    }) }}

    {{ ui.toolbar('Rechercher une entreprise…', 'Nouvelle entreprise', 'app_espace_personnel_entreprises_new') }}

    <div class="border rounded-3 overflow-hidden">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="px-4 py-3 fw-semibold border-bottom" style="font-size:1rem;">Nom</th>
                    <th class="px-4 py-3 fw-semibold border-bottom" style="font-size:1rem;">Secteur</th>
                    <th class="px-4 py-3 fw-semibold border-bottom d-none d-md-table-cell" style="font-size:1rem;">SIRET</th>
                    <th class="px-4 py-3 fw-semibold border-bottom d-none d-lg-table-cell" style="font-size:1rem;">Adresse</th>
                    <th class="px-4 py-3 fw-semibold border-bottom d-none d-lg-table-cell" style="font-size:1rem;">Compte</th>
                    <th class="px-4 py-3 fw-semibold border-bottom text-end" style="font-size:1rem;width:120px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for company in companies %}
                    <tr>
                        <td class="px-4 py-3 fw-medium text-geii-black">
                            <i class="bi bi-building me-2 text-iut-blue"></i>{{ company.nom }}
                        </td>
                        <td class="px-4 py-3 text-meta">{{ company.secteur }}</td>
                        <td class="px-4 py-3 d-none d-md-table-cell text-meta font-mono">{{ company.siret }}</td>
                        <td class="px-4 py-3 d-none d-lg-table-cell text-meta">{{ company.adresse }}</td>
                        <td class="px-4 py-3 d-none d-lg-table-cell text-meta">
                            {% if company.compte %}
                                <i class="bi bi-envelope me-1"></i>{{ company.compte.email }}
                            {% else %}
                                <span class="text-label">—</span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 text-end">
                            {{ ui.rowActions(
                                'app_espace_personnel_entreprises_edit',
                                'app_espace_personnel_entreprises_delete',
                                { id: company.id },
                                'delete-entreprise-' ~ company.id,
                                "Supprimer l'entreprise " ~ company.nom ~ " ? Cela supprimera AUSSI ses offres d'alternance et ses projets tuteurés."
                            ) }}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="px-4 py-5 text-center text-meta">Aucune entreprise. <a href="{{ path('app_espace_personnel_entreprises_new') }}">Créer la première</a>.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
