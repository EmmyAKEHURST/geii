{% set activePage = 'notes' %}
{% set breadcrumb = [
    { label: 'Espace enseignant', route: 'app_espace_enseignant_index' },
    { label: 'Pédagogie' },
    { label: 'Notes', route: 'app_espace_enseignant_notes' },
