{% set activePage = 'supports' %}
{% set breadcrumb = [
    { label: 'Espace enseignant', route: 'app_espace_enseignant_index' },
    { label: 'Pédagogie' },
    { label: 'Supports de cours', route: 'app_espace_enseignant_supports' },
    { label: isNew ? 'Déposer un PDF' : 'Modifier' },
