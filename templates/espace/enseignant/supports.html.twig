{% extends 'layouts/espace-enseignant.html.twig' %}

{% import 'espace/enseignant/_macros.html.twig' as ui %}

{% block title %}Supports de cours — Espace Enseignant — GEII{% endblock %}

{% set activePage = 'supports' %}
{% set breadcrumb = [
    { label: 'Espace enseignant', route: 'app_espace_enseignant_index' },
    { label: 'Pédagogie' },
    { label: 'Supports de cours' },
] %}

{% block page_content %}
    {{ include('espace/enseignant/_page-header.html.twig', {
        icon: 'bi-file-earmark-pdf',
        variant: 'supports',
        title: 'Supports de cours',
        subtitle: supports|length ~ ' document' ~ (supports|length > 1 ? 's' : '') ~ ' disponible' ~ (supports|length > 1 ? 's' : ''),
    }) }}

    {{ ui.toolbar('Rechercher un support…', 'Déposer un PDF', 'app_espace_enseignant_supports_new') }}

    <div class="border rounded-3 overflow-hidden">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="px-4 py-3 fw-semibold border-bottom" style="font-size:1rem;">Titre</th>
                    <th class="px-4 py-3 fw-semibold border-bottom d-none d-sm-table-cell" style="font-size:1rem;">Date dépôt</th>
                    <th class="px-4 py-3 fw-semibold border-bottom d-none d-md-table-cell" style="font-size:1rem;">Fichier</th>
                    <th class="px-4 py-3 fw-semibold border-bottom text-end" style="font-size:1rem;width:170px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for doc in supports %}
                    <tr>
                        <td class="px-4 py-3 fw-medium text-geii-black">
                            <i class="bi bi-file-earmark-pdf me-2" style="color:#b91c1c;"></i>{{ doc.titre }}
                        </td>
                        <td class="px-4 py-3 d-none d-sm-table-cell text-meta">{{ doc.dateDepot|date('d/m/Y') }}</td>
                        <td class="px-4 py-3 d-none d-md-table-cell text-meta text-truncate" style="max-width:320px;">{{ doc.fichierPath }}</td>
                        <td class="px-4 py-3 text-end">
                            <div class="d-flex gap-1 justify-content-end">
                                <a href="{{ path('app_espace_enseignant_supports_download', { id: doc.id }) }}"
                                   class="btn btn-sm btn-outline-primary" aria-label="Télécharger" title="Télécharger">
                                    <i class="bi bi-download"></i>
                                </a>
                                {{ ui.rowActions(
                                    'app_espace_enseignant_supports_edit',
                                    'app_espace_enseignant_supports_delete',
                                    { id: doc.id },
                                    'delete-support-' ~ doc.id,
                                    'Supprimer définitivement le support « ' ~ doc.titre ~ ' » ?'
                                ) }}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="px-4 py-5 text-center text-meta">
                            Aucun support. <a href="{{ path('app_espace_enseignant_supports_new') }}">Déposer le premier</a>.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
