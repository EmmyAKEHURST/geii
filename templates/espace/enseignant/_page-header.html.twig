{#
    En-tête de page réutilisable — icône colorée + titre + sous-titre.

    Paramètres :
        • icon       : classe Bootstrap Icons (ex: 'bi-clipboard2-check')
        • variant    : suffixe de la classe page-icon (ex: 'notes' → page-icon--notes)
        • title      : titre principal de la page
        • subtitle   : texte secondaire (ex: nombre d'éléments)
        • actions    : bloc HTML optionnel (boutons d'action à droite)
#}

<div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
    <div class="page-icon page-icon--{{ variant }} rounded-3 d-flex align-items-center justify-content-center">
        <i class="bi {{ icon }} fs-4"></i>
    </div>
    <div class="flex-grow-1">
        <h1 class="h3 mb-0 fw-bold">{{ title }}</h1>
        {% if subtitle is defined and subtitle %}
            <p class="mb-0 text-muted-sm">{{ subtitle }}</p>
        {% endif %}
    </div>
    {% if actions is defined and actions %}
        <div class="d-flex gap-2">{{ actions|raw }}</div>
    {% endif %}
</div>
