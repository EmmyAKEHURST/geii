{% extends 'layouts/base.html.twig' %}

{% block title %}Compte en attente — GEII{% endblock %}

{% block body_class %}public-page d-flex flex-column min-vh-100{% endblock %}
{% block main_class %}flex-grow-1 d-flex flex-column{% endblock %}

{% block navbar %}
    {% include 'partials/navbar-geii.html.twig' %}
{% endblock %}

{% block content %}
    <section class="flex-grow-1 d-flex align-items-center py-5" aria-labelledby="titre-compte-en-attente">
        <div class="container py-lg-4 w-100">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="alert alert-warning d-flex align-items-start gap-3 mb-4" role="alert">
                        <i class="bi bi-hourglass-split fs-3 flex-shrink-0" aria-hidden="true"></i>
                        <div>
                            <h1 class="h4 alert-heading mb-2" id="titre-compte-en-attente">
                                Compte en attente de validation
                            </h1>
                            <p class="mb-0">
                                Votre compte a bien été créé. Le personnel du département doit vous assigner un rôle
                                (étudiant, enseignant, entreprise…) avant que vous puissiez accéder à votre espace personnel.
                            </p>
                        </div>
                    </div>
                    <p class="text-muted text-center mb-0">
                        Vous serez notifié dès que votre accès sera activé. En attendant, vous pouvez
                        <a href="{{ path('app_home') }}">revenir à l'accueil</a>.
                    </p>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
