{#
    Thème de formulaire : champ plainPassword (RepeatedType) avec indicateur visuel.
    Utilisé par l'inscription et les formulaires Personnel (création / changement mdp).
#}
{% use 'bootstrap_5_layout.html.twig' %}

{% block repeated_row %}
    {% if form.vars.name == 'plainPassword' %}
        <div data-controller="password-strength" data-password-strength-min-length-value="{{ compte_password_min_length }}">
            <div class="mb-3">
                {{ form_label(form.first) }}
                {{ form_widget(form.first, { attr: {
                    'data-password-strength-target': 'input',
                    'data-action': 'input->password-strength#update blur->password-strength#update',
                }|merge(form.first.vars.attr) }) }}
                {{ form_errors(form.first) }}
                {{ include('partials/_password-strength-indicator.html.twig') }}
            </div>
            <div class="mb-3">
                {{ form_label(form.second) }}
                {{ form_widget(form.second) }}
                {{ form_errors(form.second) }}
            </div>
            {{ form_errors(form) }}
        </div>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}
